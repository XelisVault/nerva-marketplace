# ============================================================
# NERVA Marketplace — Environment Variables
# Copy this file to .env (frontend) and backend/.env (backend)
# and fill in real values. NEVER commit the real .env file.
# ============================================================

# ---------- Frontend (Next.js) ----------
# SQLite database file location (used by Prisma in dev/preview)
DATABASE_URL="file:./dev.db"

# Public URL of the Python market_service (FastAPI :8080 in production).
# Leave EMPTY in dev/preview to use the built-in mock API routes.
NEXT_PUBLIC_MARKET_API_BASE_URL=""

# Public URL of the Python invoice_service (FastAPI :8880 in production).
# Leave EMPTY in dev/preview to use the built-in mock API routes.
NEXT_PUBLIC_INVOICE_API_BASE_URL=""

# Public WebSocket URL of the invoice_service (ws://…:2052 in production).
# Leave EMPTY in dev/preview to use simulated payment status.
NEXT_PUBLIC_INVOICE_WS_URL=""

# ---------- Backend — market_service (FastAPI) ----------
DB_HOST="db"
DB_PORT="3306"
DB_USER="nerva_market"
DB_PASS="change-me-in-production"
DB_NAME="market"

CACHE_HOST="redis"
CACHE_PORT="6379"
CACHE_PASS="change-me-in-production"

# Internal URL the market_service uses to call the invoice_service
PAYMENTS_BASE_URL="http://payments_rest_microservices:8880"

# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Session cookie settings
SESSION_COOKIE_NAME="session_id"
SESSION_TTL_SECONDS="7200"
SESSION_SECURE="false"
SESSION_SAMESITE="lax"

# Rate limiting
RATE_LIMIT_LOGIN_PER_MIN="10"
RATE_LIMIT_REGISTER_PER_MIN="5"
RATE_LIMIT_CREATE_LISTING_PER_MIN="10"

# ---------- Backend — invoice_service (FastAPI) ----------
INV_DB_HOST="db_invoice"
INV_DB_PORT="3306"
INV_DB_USER="nerva_invoice"
INV_DB_PASS="change-me-in-production"
INV_DB_NAME="invoices_db"

# NERVA wallet RPC (nerva-wallet-rpc)
WALLET_RPC_HOST="nerva"
WALLET_RPC_PORT="28082"

# RabbitMQ for tx notifications
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="nerva_market"
RABBITMQ_PASS="change-me-in-production"

# WebSocket server
WEBSOCKET_HOST="0.0.0.0"
WEBSOCKET_PORT="2052"

# How many confirmations are required before an invoice is marked "confirmed"
REQUIRED_CONFIRMATIONS="1"

# Comma-separated list of allowed CORS origins for invoice service
INV_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
